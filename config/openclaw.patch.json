{
  "agents": {
    "defaults": {
      "models": {
        "openai/gpt-6-astra": {},
        "openai/gpt-6.1-sol": {},
        "openai/gpt-6-sol": {},
        "openai/gpt-6-luna": {}
      },
      "model": {
        "primary": "openai/gpt-6.1-sol"
      },
      "modelPolicy": {
        "allow": [
          "openai/gpt-6-astra",
          "openai/gpt-6.1-sol",
          "openai/gpt-6-sol",
          "openai/gpt-6-luna"
        ]
      },
      "systemAgent": {
        "agentId": "main"
      },
      "heartbeat": {
        "agentId": "main",
        "model": "openai/gpt-6-luna"
      }
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18790,
    "auth": {
      "mode": "token"
    }
  },
  "tools": {
    "profile": "coding"
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "plugins": {
    "entries": {
      "openai": {
        "enabled": true
      },
      "codex": {
        "enabled": true
      },
      "telegram": {
        "enabled": true
      },
      "parallel": {
        "enabled": true
      }
    }
  },
  "skills": {
    "entries": {
      "1password": {
        "enabled": false
      },
      "apple-notes": {
        "enabled": false
      },
      "apple-reminders": {
        "enabled": false
      },
      "bear-notes": {
        "enabled": false
      },
      "blogwatcher": {
        "enabled": false
      },
      "blucli": {
        "enabled": false
      },
      "camsnap": {
        "enabled": false
      },
      "coding-agent": {
